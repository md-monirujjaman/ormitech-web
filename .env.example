# Copy this file to .env.local and fill in the values.

# Public site URL used for metadata (Open Graph, canonical URLs).
NEXT_PUBLIC_SITE_URL=https://www.ormitechit.com

# Client app. All login and "Get started" links point here, and the old /login, /signup and
# /forgot-password paths on this site redirect to it.
NEXT_PUBLIC_APP_URL=https://app.ormitechit.com

# Documentation site, linked from the footer.
NEXT_PUBLIC_DOCS_URL=https://docs.ormitechit.com

# GA4 measurement ID. Public by design; code falls back to this value if unset.
# GA4 loads only in production builds, and only after the visitor accepts analytics cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HFH88XV2FG

# Reserved for future integrations. They are NOT read by the code yet; add the code first (see docs/analytics-tracking.md).
# Public IDs only. Never put server secrets (Meta access token, Sentry auth token) in NEXT_PUBLIC_ variables.
# Optional. Defaults to GTM-NNKKSCVF in src/data/site.js. Public ID, loaded only after analytics consent.
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_CLARITY_PROJECT_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
# NEXT_PUBLIC_SENTRY_DSN=
# META_CONVERSIONS_API_TOKEN=

# Cloudflare Turnstile site key for the Buy Now form on product pages (/p/...). Must match the API's CLOUDFLARE_TURNSTILE_SECRET_KEY.
# In production the API refuses orders without a valid check, so set both.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
