# Copy this file to .env.local and fill in the values.

# Public site URL used for metadata (Open Graph, canonical URLs).
NEXT_PUBLIC_SITE_URL=https://www.ormitechit.com

# Client app. All login and "Get started" links point here, and the old /login, /signup and
# /forgot-password paths on this site redirect to it.
NEXT_PUBLIC_APP_URL=https://app.ormitechit.com

# Documentation site, linked from the footer.
NEXT_PUBLIC_DOCS_URL=https://docs.ormitechit.com

# GA4 measurement ID. Public by design; code falls back to this value if unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HFH88XV2FG
